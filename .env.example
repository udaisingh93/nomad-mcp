# Nomad connection (same conventions as the official `nomad` CLI)
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_TOKEN=
NOMAD_NAMESPACE=
NOMAD_SKIP_VERIFY=false
NOMAD_CACERT=

# Write tools (stop_job, scale_task_group, restart_allocation, register_job) are
# disabled by default. Set to "on" to enable them.
NOMAD_MCP_WRITE_MODE=off

# Optional: restrict which write tools are enabled (comma-separated).
# Only has an effect when NOMAD_MCP_WRITE_MODE=on. Default: all of them.
# NOMAD_MCP_WRITE_TOOLS=stop_job,scale_task_group
